# 이 파일을 backend/.env 로 복사해서 값을 채우세요. (.env는 git에 올리지 마세요)
PORT=3001

# MySQL — Source(쓰기). Replica를 쓰면 MYSQL_READ_HOST에 Replica 주소 (비우면 Source에서 읽음)
MYSQL_HOST=127.0.0.1
MYSQL_READ_HOST=
MYSQL_PORT=3306
MYSQL_USER=playlog
MYSQL_PASSWORD=
MYSQL_DATABASE=steam

# MongoDB — 리뷰 본문 · 게임 소개 원문
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=playlog

# Steam — Web API 키 (게임 목록 · 접속자에 사용, https://steamcommunity.com/dev/apikey)
STEAM_WEB_API_KEY=
# 리뷰 수집: 표본(추천 · 비추천)당 최대 페이지 수 (1페이지 = 100건, 3어절 미만 제외로 더 필요할 수 있음)
REVIEW_MAX_PAGES=10

# Kafka — 여러 대면 쉼표로 구분
KAFKA_BROKERS=localhost:9092

# Elasticsearch — 리뷰 검색 · nori 키워드 추출 (비우면 간이 추출 사용)
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=playlog-reviews-v2
ELASTICSEARCH_API_KEY=
# simple 로 두면 ES가 있어도 nori 대신 간이 추출
KEYWORD_ANALYZER=

# Redis — 조회 캐시 (비우면 캐시 없이 DB 조회)
REDIS_URL=redis://127.0.0.1:6379

# 관리자 — 이 이메일로 가입한 회원만 관리자 페이지(#/admin)와 /api/admin/* 에 접근 (쉼표로 여러 명)
ADMIN_EMAILS=admin@playlog.com
